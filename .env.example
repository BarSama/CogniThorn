# ─── Required ────────────────────────────────────────────────────────────────
# Google Gemini 1.5 Flash API key (free tier: 15 RPM)
GEMINI_API_KEY=your_gemini_api_key_here

# Default upstream application URL (used when no per-domain upstream is configured)
UPSTREAM_URL=http://your-app:3000

# PostgreSQL password (shared by all postgres services)
POSTGRES_PASSWORD=changeme_strong_password

# ─── Optional: Self-Healing ───────────────────────────────────────────────────
# GitHub Personal Access Token (repo + pull_requests scope)
GITHUB_TOKEN=

# GitHub repository in owner/repo format
GITHUB_REPO=

# ─── Optional: Detection Tuning ───────────────────────────────────────────────
# Guard score threshold (0.0 = block everything, 1.0 = block nothing)
SENSITIVITY_THRESHOLD=0.7

# ─── Optional: ACME / Let's Encrypt ─────────────────────────────────────────
# Email for Let's Encrypt notifications
ACME_EMAIL=admin@example.com

# Use Let's Encrypt staging for testing (set to https://acme-staging-v02.api.letsencrypt.org/directory)
# ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory

# ─── Internal (usually no need to change) ────────────────────────────────────
POSTGRES_DB=cognithhorn
POSTGRES_USER=cognithhorn
DATABASE_URL=postgresql+asyncpg://cognithhorn:changeme_strong_password@pgbouncer:5432/cognithhorn
REDIS_SENTINEL_HOSTS=redis-sentinel:26379
REDIS_MASTER_NAME=mymaster
CONTROL_PLANE_URL=http://control-plane:8090
